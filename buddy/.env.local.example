# Copy this file to .env.local and fill in your values

# Supabase (get these from https://supabase.com/dashboard → your project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# CV Model API — the LANDER backend server (server.py)
# Set to the URL where your Python FastAPI server is running
# For local dev: http://localhost:8000
# For production: https://your-model-api.com
NEXT_PUBLIC_CV_MODEL_URL=http://localhost:8000

# Set to "mock" to use the built-in mock (no real server needed)
# Set to "real" to call the actual CV model API
NEXT_PUBLIC_CV_MODEL_MODE=mock
